# LiteLLM gateway
LITELLM_MASTER_KEY=sk-REPLACE-me

# Postgres
POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=REPLACE-me
DATABASE_URL=postgresql://litellm:REPLACE-me@postgres:5432/litellm

# Local model tier (company-ai). On a box already running ai-stack, the shared
# ai-net network makes http://llamacpp:8080/v1 resolvable directly.
LLAMA_API_BASE=http://llamacpp:8080/v1
LLAMA_API_KEY=REPLACE-me

# Approved cloud tier (company-claude) — AWS Bedrock auth.
# Prefer an instance role in production (terraform/); keys here for local demo only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
